# ---------------------------------------------------------------------------
# WhatsApp bridge configuration
#
# Local development needs nothing here: DATABASE_URL and SECRET_KEY are read
# from ../backend/.env automatically. In production set the first two.
# ---------------------------------------------------------------------------

# The SAME PostgreSQL database the API uses. Sessions, chats and media live there.
DATABASE_URL=postgresql://user:password@host:5432/zigmaa_crm

# Shared secret between the API and the bridge. Must be identical on both.
# (If omitted, both sides derive it from SECRET_KEY, which must then match.)
WHATSAPP_BRIDGE_TOKEN=change-me-to-a-long-random-string

# Where the API is reachable from the bridge (used for realtime wake-ups).
FASTAPI_BASE_URL=http://localhost:8000

PORT=5001

# --- Media storage ----------------------------------------------------------
# "db" (default) keeps files in PostgreSQL. "s3" uses any S3-compatible bucket
# (Cloudflare R2, AWS S3, Supabase Storage, MinIO). The API needs the same values.
# WA_MEDIA_STORAGE=s3
# WA_MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# WA_MEDIA_S3_REGION=auto
# WA_MEDIA_S3_BUCKET=zigmaa-whatsapp
# WA_MEDIA_S3_ACCESS_KEY_ID=
# WA_MEDIA_S3_SECRET_ACCESS_KEY=
# WA_MEDIA_S3_PREFIX=whatsapp
# WA_MEDIA_MAX_BYTES=67108864

# --- Optional tuning --------------------------------------------------------
# WA_SYNC_FULL_HISTORY=true
# Linked-device identity "os,browser,version". Keep "Desktop" as the browser for
# full history. Do not use "Mac OS,Desktop,..." or "Windows,Desktop,...": WhatsApp
# closes those connections before a QR code is issued (Baileys 7.0.0-rc14).
# WA_BROWSER=Zigmaa CRM,Desktop,10.0
# WA_DB_SSL=require
# WA_DB_POOL_MAX=8
# WA_LOG_LEVEL=info
# WA_BAILEYS_LOG_LEVEL=warn
